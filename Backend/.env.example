# =============================================================================
# Guardian Vision - Environment Configuration
# =============================================================================

# ---- Server ----
# GV_ENV controls the mode:
#   - "development" (default): API-only mode, frontend runs via Vite on port 5173
#   - "production":            Single-server mode, Go serves both API + React SPA on the same port
GV_ENV=development

# GV_PORT determines which port the Go server listens on.
#   Development: 8081 (API only)
#   Production:  8080 (API + React SPA both served here)
GV_PORT=8081

# ---- Database ----
GV_DB_DSN=root:@tcp(127.0.0.1:3306)/guardian_vision?parseTime=true&charset=utf8mb4&loc=Local

# ---- Authentication ----
GV_TOKEN_SECRET=change-this-secret-in-production
GV_PASSWORD_PEPPER=

# ---- CORS ----
# In development: http://localhost:5173 (Vite dev server)
# In production:  http://localhost:8080 (Go serves everything)
#
# This is auto-detected based on GV_ENV, but can be overridden here:
# GV_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080